{
  "name": "careflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.mjs",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local": "dotenv -e .env.test -- playwright test",
    "verify": "npm test && npm run test:integration && npm run lint && npm run typecheck && npm run build && npm run test:e2e:local && npm audit --audit-level=high",
    "services:start": "docker compose up -d postgres mailpit",
    "services:stop": "docker compose stop postgres mailpit",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:test:deploy": "dotenv -e .env.test -- prisma migrate deploy",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:seed": "dotenv -e .env.local -- prisma db seed"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "9.0.6",
    "otpauth": "^9.5.1",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "mysql2": "3.24.2",
    "nodemailer": "$nodemailer"
  }
}
